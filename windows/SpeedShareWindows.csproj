<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!--
      GenerateAssemblyInfo is LEFT AT ITS DEFAULT (true) so the SDK
      auto-generates AssemblyInfo.cs with the version attributes from
      Directory.Build.props AND stamps the Win32 VERSIONINFO resource
      with the same values. Without this, single-file publish produces
      an .exe with FileVersion=0.0.0.0 and the in-app update checker
      reads CurrentVersion as 0.0.0, which causes it to think every
      release is newer than itself.
    -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="app_icon.png" />
    <Manifest Include="app.manifest" />
  </ItemGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

</Project>

<Window x:Class="SpeedShareWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpeedShareWindows"
        mc:Ignorable="d"
        Title="SpeedShare - Ultra Fast Local Transfer" 
        Icon="pack://application:,,,/app_icon.png"
        Height="720" Width="1060"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" CornerRadius="18" GlassFrameThickness="0" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- OLED Midnight & Cyber Neon Palette -->
        <SolidColorBrush x:Key="BgMidnight" Color="#07090E"/>
        <SolidColorBrush x:Key="BgCard" Color="#10131B"/>
        <SolidColorBrush x:Key="BgCardHover" Color="#181C27"/>
        <SolidColorBrush x:Key="BgCardElevated" Color="#1E2333"/>
        <SolidColorBrush x:Key="BorderGlass" Color="#262C3F"/>
        <SolidColorBrush x:Key="BorderActive" Color="#6366F1"/>

        <SolidColorBrush x:Key="NeonIndigo" Color="#6366F1"/>
        <SolidColorBrush x:Key="NeonViolet" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="NeonCyan" Color="#00F2FE"/>
        <SolidColorBrush x:Key="NeonMint" Color="#00F5D4"/>
        <SolidColorBrush x:Key="NeonSky" Color="#38BDF8"/>
        <SolidColorBrush x:Key="NeonEmerald" Color="#10B981"/>
        <SolidColorBrush x:Key="NeonRose" Color="#F43F5E"/>
        <SolidColorBrush x:Key="NeonAmber" Color="#F59E0B"/>

        <SolidColorBrush x:Key="TextPureWhite" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>

        <!-- Peer Item Template -->
        <DataTemplate x:Key="PeerItemTemplate">
            <Border Background="{StaticResource BgCard}" CornerRadius="14" Margin="0,0,0,10" Padding="14,12"
                    BorderBrush="{StaticResource BorderGlass}" BorderThickness="1" Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgCardHover}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource NeonIndigo}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Platform Icon -->
                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="12" Margin="0,0,12,0"
                            Background="#181C27" BorderBrush="{StaticResource BorderGlass}" BorderThickness="1">
                        <TextBlock Text="{Binding PlatformIcon}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Device Name & IP -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DeviceName}" Foreground="{StaticResource TextPureWhite}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding IpAddress}" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                            <TextBlock Text=" • " Foreground="{StaticResource TextMuted}" FontSize="12"/>
                            <TextBlock Text="{Binding PlatformDisplay}" Foreground="{StaticResource NeonSky}" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Ping / Status Indicator -->
                    <Border Grid.Column="2" CornerRadius="8" Padding="8,4" VerticalAlignment="Center" Background="#1E1B4B" BorderBrush="#3730A3" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource NeonMint}" Margin="0,0,6,0"/>
                            <TextBlock Text="Ready" Foreground="{StaticResource NeonMint}" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Selected File Item Template -->
        <DataTemplate x:Key="FileItemTemplate">
            <Border Background="{StaticResource BgCard}" CornerRadius="10" Margin="0,0,0,6" Padding="12,8"
                    BorderBrush="{StaticResource BorderGlass}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- File Category Badge -->
                    <Border Grid.Column="0" Background="{Binding CategoryColor}" CornerRadius="6" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileCategory}" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold"/>
                    </Border>

                    <!-- File Info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPureWhite}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding FormattedSize}" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                    </StackPanel>

                    <!-- Remove Button -->
                    <Button Grid.Column="2" Tag="{Binding}" Click="RemoveFileButton_Click" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" Padding="6" VerticalAlignment="Center">
                        <TextBlock Text="✕" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="Bold"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- Outer Window Container with Rounded Border -->
    <Border Background="{StaticResource BgMidnight}" CornerRadius="18" BorderBrush="{StaticResource BorderGlass}" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <!-- Ambient Background Glows -->
            <Ellipse Width="450" Height="450" Fill="#6366F1" Opacity="0.08" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-120,-120,0,0" IsHitTestVisible="False"/>
            <Ellipse Width="450" Height="450" Fill="#00F5D4" Opacity="0.06" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-120,-120" IsHitTestVisible="False"/>

            <Grid Margin="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title Bar -->
                    <RowDefinition Height="*"/>    <!-- Main Workspace -->
                </Grid.RowDefinitions>

                <!-- =================== CUSTOM TITLE BAR =================== -->
                <Grid Grid.Row="0" Margin="0,0,0,20" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Brand Logo & Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/app_icon.png" Width="38" Height="38" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Speed" Foreground="{StaticResource TextPureWhite}" FontWeight="Bold" FontSize="19"/>
                                <TextBlock Text="Share" Foreground="{StaticResource NeonCyan}" FontWeight="Bold" FontSize="19"/>
                                <Border Background="#1E1B4B" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center" BorderBrush="#3730A3" BorderThickness="1">
                                    <TextBlock Text="Ultra-Fast LAN" Foreground="{StaticResource NeonMint}" FontSize="9" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="LocalInfoText" Text="Initializing..." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Window Action Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button x:Name="BtnOpenFolder" Click="BtnOpenFolder_Click" Cursor="Hand" Margin="0,0,8,0"
                                Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderGlass}" BorderThickness="1"
                                Padding="12,6" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📂 Downloads" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnSettings" Click="BtnSettings_Click" Cursor="Hand"
                                Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderGlass}" BorderThickness="1"
                                Padding="12,6" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock Text="⚙️ Settings" Foreground="{StaticResource TextSecondary}"/>
                        </Button>
                    </StackPanel>

                    <!-- Minimize & Close Buttons -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="MinimizeButton_Click" Width="32" Height="32" Cursor="Hand" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderGlass}" BorderThickness="1" Margin="0,0,6,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                        <TextBlock Text="—" Foreground="{StaticResource TextSecondary}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Click="CloseButton_Click" Width="32" Height="32" Cursor="Hand" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderGlass}" BorderThickness="1">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                        <TextBlock Text="✕" Foreground="{StaticResource NeonRose}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- =================== MAIN WORKSPACE =================== -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/> <!-- Left: Discovered Peers -->
                        <ColumnDefinition Width="20"/>  <!-- Gap -->
                        <ColumnDefinition Width="*"/>   <!-- Right: Files Deck & Send Action -->
                    </Grid.ColumnDefinitions>

                    <!-- LEFT PANEL: Discovered Devices Radar -->
                    <Border Grid.Column="0" Background="{StaticResource BgCard}" CornerRadius="16" BorderBrush="{StaticResource BorderGlass}" BorderThickness="1" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Header -->
                                <RowDefinition Height="*"/>    <!-- Devices List -->
                                <RowDefinition Height="Auto"/> <!-- Selected Device Card -->
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Nearby Devices" Foreground="{StaticResource TextPureWhite}" FontWeight="Bold" FontSize="15"/>
                                    <Border Background="#1E1B4B" CornerRadius="8" Padding="6,2" Margin="8,0,0,0">
                                        <TextBlock x:Name="TxtDeviceCount" Text="0" Foreground="{StaticResource NeonMint}" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="BtnRefresh" Click="BtnRefresh_Click" Cursor="Hand"
                                        Background="{StaticResource BgCardHover}" BorderBrush="{StaticResource BorderGlass}" BorderThickness="1" Padding="8,4">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <TextBlock Text="🔄 Scan LAN" Foreground="{StaticResource NeonCyan}" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- Peers ListBox -->
                            <ListBox Grid.Row="1" x:Name="PeersListBox" Background="Transparent" BorderThickness="0"
                                     ItemTemplate="{StaticResource PeerItemTemplate}" SelectionChanged="PeersListBox_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <!-- Empty Discovery State -->
                            <StackPanel Grid.Row="1" x:Name="NoDevicesPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                                <Border Width="56" Height="56" CornerRadius="28" Background="#181C27" HorizontalAlignment="Center" Margin="0,0,0,12" BorderBrush="{StaticResource BorderGlass}" BorderThickness="1">
                                    <TextBlock Text="📡" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Scanning Local Wi-Fi..." Foreground="{StaticResource TextPureWhite}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock Text="Open SpeedShare on your Android phone or another PC on this network." Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- Selected Peer Card -->
                            <Border Grid.Row="2" x:Name="SelectedPeerCard" Visibility="Collapsed" Background="#1E1B4B" CornerRadius="12" Padding="12" Margin="0,10,0,0" BorderBrush="{StaticResource NeonIndigo}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="SENDING TARGET" Foreground="{StaticResource NeonCyan}" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtSelectedPeerName" Text="Device Name" Foreground="{StaticResource TextPureWhite}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Click="ClearSelectedPeer_Click" Background="Transparent" BorderThickness="0" Foreground="{StaticResource NeonRose}" FontSize="12" Cursor="Hand">
                                        <TextBlock Text="Clear"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- RIGHT PANEL: File Queue & Streaming Engine -->
                    <Border Grid.Column="2" Background="{StaticResource BgCard}" CornerRadius="16" BorderBrush="{StaticResource BorderGlass}" BorderThickness="1" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Drop Zone / Selector -->
                                <RowDefinition Height="*"/>    <!-- Selected Files List -->
                                <RowDefinition Height="Auto"/> <!-- Send Action & Live Gauges -->
                            </Grid.RowDefinitions>

                            <!-- Drop Zone -->
                            <Border Grid.Row="0" x:Name="DropZone" Height="110" CornerRadius="14" Background="{StaticResource BgMidnight}"
                                    BorderBrush="{StaticResource BorderGlass}" BorderThickness="1.5"
                                    AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave"
                                    MouseLeftButtonDown="DropZone_Click" Cursor="Hand">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="⚡ Drop Files or Click to Browse" Foreground="{StaticResource NeonCyan}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Select 4K Videos, Photos, Folders, Archives (Unlimited Size)" Foreground="{StaticResource TextMuted}" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Files List Area -->
                            <Grid Grid.Row="1" Margin="0,14,0,14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Files Queue" Foreground="{StaticResource TextPureWhite}" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock x:Name="TxtFilesSummary" Text="(0 files, 0 B)" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="6,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="BtnClearFiles" Click="BtnClearFiles_Click" Content="Clear All" Foreground="{StaticResource NeonRose}" Background="Transparent" BorderThickness="0" Cursor="Hand" Visibility="Collapsed" FontSize="12"/>
                                </Grid>

                                <ListBox Grid.Row="1" x:Name="FilesListBox" Background="Transparent" BorderThickness="0"
                                         ItemTemplate="{StaticResource FileItemTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>

                                <StackPanel Grid.Row="1" x:Name="NoFilesPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="No files selected yet" Foreground="{StaticResource TextMuted}" FontSize="13" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Bottom Action Deck -->
                            <Border Grid.Row="2" Background="{StaticResource BgMidnight}" CornerRadius="14" Padding="14" BorderBrush="{StaticResource BorderGlass}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtSendHint" Text="Select a target device on the left and choose files above." Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" x:Name="BtnSend" Click="BtnSend_Click" IsEnabled="False" Cursor="Hand" Margin="14,0,0,0"
                                            Background="{StaticResource NeonIndigo}" Foreground="{StaticResource TextPureWhite}" FontSize="14" FontWeight="Bold" Padding="24,12">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="🚀 Send Files" Foreground="{TemplateBinding Foreground}"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- =================== MODAL 1: INCOMING REQUEST =================== -->
            <Grid x:Name="IncomingModal" Visibility="Collapsed" Background="#D907090E">
                <Border Background="{StaticResource BgCard}" CornerRadius="18" BorderBrush="{StaticResource BorderGlass}" BorderThickness="1"
                        Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="40" Height="40" CornerRadius="20" Background="#1E1B4B" Margin="0,0,12,0">
                                <TextBlock Text="📥" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Incoming Transfer" Foreground="{StaticResource TextPureWhite}" FontWeight="Bold" FontSize="17"/>
                                <TextBlock x:Name="TxtIncomingSender" Text="Device wants to send you files" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="TxtIncomingTotalSize" Text="Total Size: 0 MB" Foreground="{StaticResource NeonMint}" FontWeight="Bold" FontSize="14" Margin="0,4,0,10"/>

                        <Border Background="{StaticResource BgMidnight}" CornerRadius="10" Padding="10" MaxHeight="140" BorderBrush="{StaticResource BorderGlass}" BorderThickness="1" Margin="0,0,0,18">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="IncomingFilesListPanel"/>
                            </ScrollViewer>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Click="BtnDeclineTransfer_Click" Background="{StaticResource BgCardHover}" BorderBrush="{StaticResource BorderGlass}" BorderThickness="1" Padding="14,10" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                            <TextBlock Text="Decline" Foreground="{StaticResource NeonRose}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Grid.Column="2" Click="BtnAcceptTransfer_Click" Background="{StaticResource NeonMint}" Padding="14,10" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                            <TextBlock Text="Accept &amp; Save" Foreground="Black" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- =================== MODAL 2: LIVE HIGH-SPEED TRANSFER =================== -->
            <Grid x:Name="TransferModal" Visibility="Collapsed" Background="#D907090E">
                <Border Background="{StaticResource BgCard}" CornerRadius="20" BorderBrush="{StaticResource NeonIndigo}" BorderThickness="1.5"
                        Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="26">
                    <StackPanel>
                        <TextBlock x:Name="TxtTransferTitle" Text="High-Speed Transfer" Foreground="{StaticResource TextPureWhite}" FontWeight="Bold" FontSize="18"/>
                        <TextBlock x:Name="TxtTransferSubTitle" Text="Streaming direct over local TCP sockets..." Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,16"/>

                        <!-- Speedometer HUD -->
                        <Border Background="{StaticResource BgMidnight}" CornerRadius="12" Padding="14" Margin="0,0,0,14" BorderBrush="{StaticResource BorderGlass}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="THROUGHPUT" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TxtLiveSpeed" Text="0.0 MB/s" Foreground="{StaticResource NeonCyan}" FontWeight="Bold" FontSize="26"/>
                                        <TextBlock x:Name="TxtLiveBitrate" Text="0 Mbps" Foreground="{StaticResource TextMuted}" FontSize="13" VerticalAlignment="Bottom" Margin="8,0,0,4"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="TIME REMAINING" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="TxtTransferEta" Text="Calculating..." Foreground="{StaticResource NeonMint}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ProgressBar x:Name="TransferProgressBar" Height="10" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,10"
                                     Foreground="{StaticResource NeonCyan}" Background="{StaticResource BgMidnight}"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtTransferStats" Text="0 B / 0 B (0%)" Foreground="{StaticResource TextPureWhite}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" x:Name="TxtCurrentFile" Text="Preparing..." Foreground="{StaticResource TextMuted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <Button x:Name="BtnCancelTransfer" Click="BtnCancelTransfer_Click" Content="Cancel Transfer" Margin="0,14,0,0"
                                Background="{StaticResource BgCardHover}" BorderBrush="{StaticResource BorderGlass}" BorderThickness="1"
                                Foreground="{StaticResource NeonRose}" FontWeight="Bold" Padding="14,10" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- =================== MODAL 3: SETTINGS =================== -->
            <Grid x:Name="SettingsModal" Visibility="Collapsed" Background="#D907090E">
                <Border Background="{StaticResource BgCard}" CornerRadius="18" BorderBrush="{StaticResource BorderGlass}" BorderThickness="1"
                        Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                    <StackPanel>
                        <TextBlock Text="SpeedShare Settings" Foreground="{StaticResource TextPureWhite}" FontWeight="Bold" FontSize="17" Margin="0,0,0,16"/>

                        <TextBlock Text="Visible Device Name" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtCustomDeviceName" Background="{StaticResource BgMidnight}" Foreground="{StaticResource TextPureWhite}"
                                 BorderBrush="{StaticResource BorderGlass}" Padding="10,8" FontSize="13" Margin="0,0,0,14"/>

                        <TextBlock Text="Downloads Folder" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtDownloadFolder" Background="{StaticResource BgMidnight}" Foreground="{StaticResource TextPureWhite}"
                                     BorderBrush="{StaticResource BorderGlass}" Padding="10,8" FontSize="13" IsReadOnly="True"/>
                            <Button Grid.Column="1" Click="BtnBrowseFolder_Click" Content="Browse..." Margin="8,0,0,0"
                                    Background="{StaticResource BgCardHover}" BorderBrush="{StaticResource BorderGlass}" BorderThickness="1"
                                    Foreground="{StaticResource TextPureWhite}" Padding="12,8" Cursor="Hand"/>
                        </Grid>

                        <!-- Updates Check in Settings -->
                        <Border Background="{StaticResource BgMidnight}" CornerRadius="10" Padding="12,10" Margin="0,0,0,20" BorderBrush="{StaticResource BorderGlass}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtSettingsUpdateTitle" Text="SpeedShare v0.0.0" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtSettingsUpdateStatus" Text="Check for newer versions" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="BtnCheckUpdateManual" Click="BtnCheckUpdateManual_Click" Content="Check Now"
                                        Background="{StaticResource BgCardHover}" BorderBrush="{StaticResource BorderGlass}" BorderThickness="1"
                                        Foreground="{StaticResource NeonCyan}" Padding="10,6" FontSize="11" FontWeight="SemiBold" Cursor="Hand"/>
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Click="BtnCloseSettings_Click" Content="Cancel"
                                    Background="{StaticResource BgCardHover}" BorderBrush="{StaticResource BorderGlass}" BorderThickness="1"
                                    Foreground="{StaticResource TextSecondary}" Padding="12,8" Cursor="Hand"/>
                            <Button Grid.Column="2" Click="BtnSaveSettings_Click" Content="Save"
                                    Background="{StaticResource NeonIndigo}" Foreground="{StaticResource TextPureWhite}" FontWeight="Bold" Padding="12,8" Cursor="Hand"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- =================== MODAL 4: AUTO-UPDATE =================== -->
            <Grid x:Name="UpdateModal" Visibility="Collapsed" Background="#D907090E">
                <Border Background="{StaticResource BgCard}" CornerRadius="20" BorderBrush="{StaticResource NeonCyan}" BorderThickness="1.5"
                        Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="26">
                    <StackPanel>
                        <!-- Header & Version Tags -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#181C27" BorderBrush="{StaticResource BorderGlass}" BorderThickness="1" Margin="0,0,12,0">
                                <TextBlock Text="🚀" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="New Update Available!" Foreground="{StaticResource TextPureWhite}" FontWeight="Bold" FontSize="17"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock x:Name="TxtUpdateNewVersion" Text="v0.0.0" Foreground="{StaticResource NeonMint}" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock x:Name="TxtUpdateCurrentVersion" Text=" • Current: v0.0.0" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="RELEASE NOTES" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                        <Border Background="{StaticResource BgMidnight}" CornerRadius="10" Padding="12" Margin="0,0,0,16" BorderBrush="{StaticResource BorderGlass}" BorderThickness="1" MaxHeight="140">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="TxtUpdateChangelog" Text="Loading changelog..." Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                            </ScrollViewer>
                        </Border>

                        <!-- Download Progress Bar (visible during download) -->
                        <StackPanel x:Name="UpdateProgressPanel" Visibility="Collapsed" Margin="0,0,0,14">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Downloading update..." Foreground="{StaticResource NeonCyan}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" x:Name="TxtUpdateProgressPercent" Text="0%" Foreground="{StaticResource TextPureWhite}" FontSize="12"/>
                            </Grid>
                            <ProgressBar x:Name="UpdateProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource NeonCyan}" Background="{StaticResource BgMidnight}"/>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <Grid x:Name="UpdateActionButtons">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Click="BtnDismissUpdate_Click" Content="Later"
                                    Background="{StaticResource BgCardHover}" BorderBrush="{StaticResource BorderGlass}" BorderThickness="1"
                                    Foreground="{StaticResource TextSecondary}" Padding="10,8" Cursor="Hand"/>
                            <Button Grid.Column="2" Click="BtnViewRelease_Click" Content="GitHub"
                                    Background="{StaticResource BgCardHover}" BorderBrush="{StaticResource BorderGlass}" BorderThickness="1"
                                    Foreground="{StaticResource TextPureWhite}" Padding="10,8" Cursor="Hand"/>
                            <Button Grid.Column="4" x:Name="BtnUpdateNow" Click="BtnUpdateNow_Click" Content="Update Now"
                                    Background="{StaticResource NeonIndigo}" Foreground="{StaticResource TextPureWhite}" FontWeight="Bold" Padding="10,8" Cursor="Hand"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>

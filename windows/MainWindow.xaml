<Window x:Class="SpeedShareWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpeedShareWindows"
        mc:Ignorable="d"
        Title="SpeedShare - Ultra Fast Local Transfer" 
        Icon="pack://application:,,,/app_icon.png"
        Height="720" Width="1100"
        MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" CornerRadius="16" GlassFrameThickness="0" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ==================== PEER CARD TEMPLATE ==================== -->
        <DataTemplate x:Key="PeerItemTemplate">
            <Border Background="{DynamicResource CardBrush}" CornerRadius="14" Margin="0,0,0,10" Padding="14,12"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Platform icon -->
                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="12" Margin="0,0,12,0"
                            Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBlock Text="{Binding PlatformIcon}" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>

                    <!-- Name & meta -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DeviceName}" Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding IpAddress}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="  •  " Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding PlatformDisplay}" Foreground="{DynamicResource InfoBrush}" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Ready pill -->
                    <Border Grid.Column="2" CornerRadius="20" Padding="9,4" VerticalAlignment="Center"
                            Background="{DynamicResource SuccessSoftBrush}" BorderBrush="{DynamicResource SuccessSoftBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="Ready" Foreground="{DynamicResource OnSuccessSoftBrush}" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ==================== FILE ROW TEMPLATE ==================== -->
        <DataTemplate x:Key="FileItemTemplate">
            <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Margin="0,0,0,6" Padding="12,8"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Category chip -->
                    <Border Grid.Column="0" Background="{Binding CategoryColor}" CornerRadius="7" Padding="7,2" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileCategory}" Foreground="White" FontSize="9" FontWeight="Bold"/>
                    </Border>

                    <!-- File info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding FormattedSize}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                    </StackPanel>

                    <!-- Remove -->
                    <Button Grid.Column="2" Tag="{Binding}" Click="RemoveFileButton_Click" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" Padding="6" VerticalAlignment="Center">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- Outer window chrome -->
    <Border Background="{DynamicResource CanvasBrush}" CornerRadius="16" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" ClipToBounds="True">
        <Grid>
            <!-- Ambient brand glow -->
            <Ellipse Width="520" Height="520" Fill="{DynamicResource GlowBrush}" Opacity="0.06"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-180,-180,0,0" IsHitTestVisible="False"/>

            <Grid Margin="14,12,14,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="66"/>  <!-- Nav rail -->
                    <ColumnDefinition Width="*"/>   <!-- Content -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Title bar -->
                    <RowDefinition Height="*"/>     <!-- Workspace -->
                </Grid.RowDefinitions>

                <!-- ==================== TITLE BAR ==================== -->
                <Grid Grid.Row="0" Grid.Column="1" Margin="10,0,0,14" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Brand -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="11" Margin="0,0,11,0" Background="{DynamicResource BrandGradient}">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                       Foreground="{DynamicResource OnBrandBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="SpeedShare" Style="{StaticResource TitleText}" FontSize="18"/>
                                <Border Background="{DynamicResource BrandSoftBrush}" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="v2.0" Foreground="{DynamicResource OnBrandSoftBrush}" FontSize="9" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="LocalInfoText" Text="Initializing…" Style="{StaticResource CaptionText}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Global header actions -->
                    <Button Grid.Column="2" x:Name="BtnOpenFolder" Click="BtnOpenFolder_Click" Cursor="Hand" Margin="0,0,8,0"
                            Style="{StaticResource GhostButton}" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text=" Downloads" FontSize="12" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3" x:Name="BtnThemeToggle" Click="BtnThemeToggle_Click" Cursor="Hand" Margin="0,0,8,0"
                            Style="{StaticResource GhostButton}" Padding="10,6" ToolTip="Toggle light / dark">
                        <TextBlock x:Name="ThemeToggleIcon" Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                    </Button>

                    <Button Grid.Column="4" x:Name="BtnSettings" Click="BtnSettings_Click" Cursor="Hand" Margin="0,0,8,0"
                            Style="{StaticResource GhostButton}" Padding="10,6" ToolTip="Settings">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                    </Button>

                    <!-- Window controls -->
                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="MinimizeButton_Click" Width="36" Height="34" Cursor="Hand" Style="{StaticResource GhostButton}">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Click="CloseButton_Click" Width="36" Height="34" Cursor="Hand" Style="{StaticResource GhostButton}">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource ErrorBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ==================== NAV RAIL ==================== -->
                <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource CardBrush}" CornerRadius="14"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="6" Margin="0,0,0,0">
                    <StackPanel>
                        <Button x:Name="NavHome" Click="NavHome_Click" Style="{StaticResource GhostButton}" Padding="0" Margin="0,4,0,6">
                            <StackPanel>
                                <TextBlock x:Name="NavHomeIcon" Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/>
                                <TextBlock Text="Home" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavSettings" Click="NavSettings_Click" Style="{StaticResource GhostButton}" Padding="0">
                            <StackPanel>
                                <TextBlock x:Name="NavSettingsIcon" Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/>
                                <TextBlock Text="Settings" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ==================== WORKSPACE ==================== -->
                <Grid Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">

                    <!-- ========== HOME PAGE ========== -->
                    <Grid x:Name="HomePage">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="376"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: Devices -->
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Nearby devices" Style="{StaticResource HeadingText}"/>
                                        <Border Background="{DynamicResource SuccessSoftBrush}" CornerRadius="20" Padding="9,2" Margin="10,0,0,0">
                                            <TextBlock x:Name="TxtDeviceCount" Text="0" Foreground="{DynamicResource OnSuccessSoftBrush}" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="BtnRefresh" Click="BtnRefresh_Click" Cursor="Hand"
                                            Style="{StaticResource GhostButton}" Padding="9,5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Text=" Scan" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Peer list -->
                                <ListBox Grid.Row="1" x:Name="PeersListBox" Background="Transparent" BorderThickness="0"
                                         ItemTemplate="{StaticResource PeerItemTemplate}"
                                         SelectionChanged="PeersListBox_SelectionChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>

                                <!-- Empty state -->
                                <StackPanel Grid.Row="1" x:Name="NoDevicesPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                                    <Border Width="56" Height="56" CornerRadius="18" Background="{DynamicResource RaisedBrush}"
                                            HorizontalAlignment="Center" Margin="0,0,0,12"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                                   Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="No devices nearby yet" Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Open SpeedShare on your Android phone or another PC on this network."
                                               Style="{StaticResource BodyText}" FontSize="12" TextWrapping="Wrap"
                                               TextAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>

                                <!-- Selected peer -->
                                <Border Grid.Row="2" x:Name="SelectedPeerCard" Visibility="Collapsed"
                                        Background="{DynamicResource BrandSoftBrush}" CornerRadius="12" Padding="12"
                                        Margin="0,10,0,0" BorderBrush="{DynamicResource BrandBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="SENDING TARGET" Foreground="{DynamicResource OnBrandSoftBrush}" FontSize="9" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtSelectedPeerName" Text="Device name" Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Click="ClearSelectedPeer_Click" Style="{StaticResource GhostButton}"
                                                Padding="6,4" Foreground="{DynamicResource ErrorBrush}" FontSize="12" Cursor="Hand">
                                            <TextBlock Text="Clear"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- RIGHT: Send deck -->
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Drop zone -->
                                <Border Grid.Row="0" x:Name="DropZone" Height="108" CornerRadius="14" Background="{DynamicResource RaisedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                                        AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave"
                                        MouseLeftButtonDown="DropZone_Click" Cursor="Hand">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                                   Foreground="{DynamicResource InfoBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Drop files here or click to browse" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                        <TextBlock Text="Videos, photos, folders, archives — unlimited size"
                                                   Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Files -->
                                <Grid Grid.Row="1" Margin="0,16,0,16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Files queue" Style="{StaticResource HeadingText}" FontSize="14"/>
                                            <TextBlock x:Name="TxtFilesSummary" Text="(0 files, 0 B)" Style="{StaticResource CaptionText}" Margin="8,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="BtnClearFiles" Click="BtnClearFiles_Click"
                                                Style="{StaticResource GhostButton}" Visibility="Collapsed">
                                            <TextBlock Text="Clear all" Foreground="{DynamicResource ErrorBrush}" FontSize="12"/>
                                        </Button>
                                    </Grid>

                                    <ListBox Grid.Row="1" x:Name="FilesListBox" Background="Transparent" BorderThickness="0"
                                             ItemTemplate="{StaticResource FileItemTemplate}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>

                                    <StackPanel Grid.Row="1" x:Name="NoFilesPanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="No files selected yet" Style="{StaticResource BodyText}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Action deck -->
                                <Border Grid.Row="2" Background="{DynamicResource RaisedBrush}" CornerRadius="14" Padding="14"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtSendHint" Text="Select a device on the left, then add files above."
                                                       Style="{StaticResource BodyText}" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="BtnSend" Click="BtnSend_Click" IsEnabled="False"
                                                Cursor="Hand" Margin="16,0,0,0" Style="{StaticResource ModernButton}" Padding="26,11" FontSize="14">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"/>
                                                <TextBlock Text=" Send files" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ========== SETTINGS PAGE ========== -->
                    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="0,0,4,0">
                        <StackPanel Margin="0,0,18,18">
                            <TextBlock Text="Settings" Style="{StaticResource TitleText}" Margin="0,0,0,4"/>
                            <TextBlock Text="Appearance, device identity, and updates." Style="{StaticResource BodyText}" Margin="0,0,0,20"/>

                            <!-- Appearance -->
                            <TextBlock Text="Appearance" Style="{StaticResource HeadingText}" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource BrandSoftBrush}" Margin="0,0,14,0">
                                        <TextBlock Text="&#xE793;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                                   Foreground="{DynamicResource OnBrandSoftBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Theme" Style="{StaticResource HeadingText}" FontSize="14"/>
                                        <TextBlock Text="Follows your system, or choose light or dark." Style="{StaticResource BodyText}" FontSize="12" Margin="0,3,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                            <RadioButton x:Name="RadioThemeSystem" Content="System" GroupName="ThemeGroup"
                                                         Checked="ThemeRadio_Checked" Foreground="{DynamicResource TextPrimaryBrush}"
                                                         FontSize="12" Margin="0,0,20,0"/>
                                            <RadioButton x:Name="RadioThemeLight" Content="Light" GroupName="ThemeGroup"
                                                         Checked="ThemeRadio_Checked" Foreground="{DynamicResource TextPrimaryBrush}"
                                                         FontSize="12" Margin="0,0,20,0"/>
                                            <RadioButton x:Name="RadioThemeDark" Content="Dark" GroupName="ThemeGroup"
                                                         Checked="ThemeRadio_Checked" Foreground="{DynamicResource TextPrimaryBrush}"
                                                         FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Device -->
                            <TextBlock Text="Device" Style="{StaticResource HeadingText}" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="Visible device name" Style="{StaticResource BodyText}" FontSize="12" Margin="0,0,0,6"/>
                                    <TextBox x:Name="TxtCustomDeviceName" Background="{DynamicResource FieldBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                             Padding="11,9" FontSize="13"/>
                                    <TextBlock Text="Shown to other devices on your network." Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Downloads -->
                            <TextBlock Text="Downloads" Style="{StaticResource HeadingText}" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="Save received files to" Style="{StaticResource BodyText}" FontSize="12" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtDownloadFolder" Background="{DynamicResource FieldBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                 Padding="11,9" FontSize="13" IsReadOnly="True"/>
                                        <Button Grid.Column="1" Click="BtnBrowseFolder_Click" Content="Browse…" Margin="10,0,0,0"
                                                Style="{StaticResource SecondaryButton}" Padding="16,8"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Updates -->
                            <TextBlock Text="Updates" Style="{StaticResource HeadingText}" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtSettingsUpdateTitle" Text="SpeedShare v0.0.0" Style="{StaticResource HeadingText}" FontSize="14"/>
                                        <TextBlock x:Name="TxtSettingsUpdateStatus" Text="Checking for newer versions"
                                                   Style="{StaticResource BodyText}" FontSize="12" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="BtnCheckUpdateManual" Click="BtnCheckUpdateManual_Click"
                                            Style="{StaticResource SecondaryButton}" Padding="18,9">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text=" Check now" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- About -->
                            <TextBlock Text="About" Style="{StaticResource HeadingText}" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource CardStyle}" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="SpeedShare — private, direct, fast." Style="{StaticResource BodyText}"/>
                                    <TextBlock Text="Zero-cloud peer-to-peer file sharing over your local network. Files never leave your Wi-Fi."
                                               Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ==================== OVERLAYS ==================== -->
                <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2" x:Name="IncomingModal"
                      Visibility="Collapsed" Background="{DynamicResource ScrimBrush}">
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Width="470" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Width="44" Height="44" CornerRadius="14" Background="{DynamicResource BrandGradient}" Margin="0,0,13,0">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                               Foreground="{DynamicResource OnBrandBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Incoming transfer" Style="{StaticResource HeadingText}" FontSize="17"/>
                                    <TextBlock x:Name="TxtIncomingSender" Text="Device wants to send you files" Style="{StaticResource BodyText}" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock x:Name="TxtIncomingTotalSize" Text="Total size: 0 MB" Foreground="{DynamicResource SuccessBrush}"
                                       FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>

                            <Border Background="{DynamicResource RaisedBrush}" CornerRadius="12" Padding="10" MaxHeight="150"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,20">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="IncomingFilesListPanel"/>
                                </ScrollViewer>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Click="BtnDeclineTransfer_Click" Style="{StaticResource DangerButton}" Padding="14,10">
                                    <TextBlock Text="Decline" FontWeight="Bold"/>
                                </Button>
                                <Button Grid.Column="2" Click="BtnAcceptTransfer_Click" Style="{StaticResource ModernButton}" Padding="14,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Text=" Accept &amp; save" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2" x:Name="TransferModal"
                      Visibility="Collapsed" Background="{DynamicResource ScrimBrush}">
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="20" BorderBrush="{DynamicResource BrandBrush}" BorderThickness="1.5"
                            Width="520" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="26">
                        <StackPanel>
                            <TextBlock x:Name="TxtTransferTitle" Text="High-speed transfer" Style="{StaticResource TitleText}" FontSize="19"/>
                            <TextBlock x:Name="TxtTransferSubTitle" Text="Streaming direct over local TCP…" Style="{StaticResource BodyText}" FontSize="12" Margin="0,2,0,18"/>

                            <!-- HUD -->
                            <Border Background="{DynamicResource RaisedBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,14"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="THROUGHPUT" Style="{StaticResource CaptionText}" FontSize="10" FontWeight="Bold"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="TxtLiveSpeed" Text="0.0 MB/s" Foreground="{DynamicResource InfoBrush}" FontWeight="Bold" FontSize="27"/>
                                            <TextBlock x:Name="TxtLiveBitrate" Text="0 Mbps" Style="{StaticResource CaptionText}" FontSize="13"
                                                       VerticalAlignment="Bottom" Margin="8,0,0,4"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="TIME REMAINING" Style="{StaticResource CaptionText}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        <TextBlock x:Name="TxtTransferEta" Text="Calculating…" Foreground="{DynamicResource SuccessBrush}"
                                                   FontWeight="Bold" FontSize="14" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ProgressBar x:Name="TransferProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,12"
                                         Foreground="{DynamicResource BrandGradient}" Background="{DynamicResource RaisedBrush}"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtTransferStats" Text="0 B / 0 B (0%)" Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" x:Name="TxtCurrentFile" Text="Preparing…" Style="{StaticResource CaptionText}"
                                           FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </Grid>

                            <Button x:Name="BtnCancelTransfer" Click="BtnCancelTransfer_Click" Margin="0,16,0,0"
                                    Style="{StaticResource SecondaryButton}" Padding="14,10">
                                <TextBlock Text="Cancel transfer" FontWeight="SemiBold"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2" x:Name="UpdateModal"
                      Visibility="Collapsed" Background="{DynamicResource ScrimBrush}">
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="20" BorderBrush="{DynamicResource BrandBrush}" BorderThickness="1.5"
                            Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="26">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="46" Height="46" CornerRadius="14" Background="{DynamicResource BrandGradient}" Margin="0,0,13,0">
                                    <TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                               Foreground="{DynamicResource OnBrandBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="New update available" Style="{StaticResource HeadingText}" FontSize="17"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock x:Name="TxtUpdateNewVersion" Text="v0.0.0" Foreground="{DynamicResource SuccessBrush}"
                                                   FontWeight="Bold" FontSize="12"/>
                                        <TextBlock x:Name="TxtUpdateCurrentVersion" Text="  •  Current: v0.0.0" Style="{StaticResource CaptionText}" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Release notes" Style="{StaticResource CaptionText}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                            <Border Background="{DynamicResource RaisedBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,16"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MaxHeight="150">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="TxtUpdateChangelog" Text="Loading changelog…" Style="{StaticResource BodyText}"
                                               FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                                </ScrollViewer>
                            </Border>

                            <StackPanel x:Name="UpdateProgressPanel" Visibility="Collapsed" Margin="0,0,0,16">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Downloading update…" Foreground="{DynamicResource InfoBrush}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtUpdateProgressPercent" Text="0%" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                                </Grid>
                                <ProgressBar x:Name="UpdateProgressBar" Height="8" Minimum="0" Maximum="100" Value="0"
                                             Foreground="{DynamicResource BrandGradient}" Background="{DynamicResource RaisedBrush}"/>
                            </StackPanel>

                            <Grid x:Name="UpdateActionButtons">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Click="BtnDismissUpdate_Click" Style="{StaticResource GhostButton}">
                                    <TextBlock Text="Later"/>
                                </Button>
                                <Button Grid.Column="2" Click="BtnViewRelease_Click" Style="{StaticResource SecondaryButton}">
                                    <TextBlock Text="GitHub"/>
                                </Button>
                                <Button Grid.Column="4" x:Name="BtnUpdateNow" Click="BtnUpdateNow_Click" Style="{StaticResource ModernButton}">
                                    <TextBlock Text="Update now"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>

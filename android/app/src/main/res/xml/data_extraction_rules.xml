<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- android:allowBackup="false" in the manifest means nothing is
         backed up or transferred. The rules below are kept for
         documentation and would only take effect if that flag is
         flipped in the future. -->
    <cloud-backup>
        <include domain="sharedpref" path="speedshare_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="speedshare_prefs.xml" />
    </device-transfer>
</data-extraction-rules>

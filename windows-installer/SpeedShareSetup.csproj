<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>SpeedShare-Setup</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- See windows/SpeedShareWindows.csproj for the full explanation
         of why GenerateAssemblyInfo is left enabled. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- CA1416 doesn't fire on net10.0-windows targets; no NoWarn needed. -->
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\windows\publish\SpeedShareWindows.exe" LogicalName="Payload.SpeedShareWindows.exe" />
    <Manifest Include="app.manifest" />
  </ItemGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

</Project>

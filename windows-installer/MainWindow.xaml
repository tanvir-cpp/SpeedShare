<Window x:Class="SpeedShareSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpeedShare Setup" 
        Height="460" Width="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource CanvasBrush}">

    <Grid Margin="26">
        <!-- Ambient brand glow -->
        <Ellipse Width="300" Height="300" Fill="{DynamicResource BrandBrush}" Opacity="0.05"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-60,-60" IsHitTestVisible="False"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="15" Background="{DynamicResource BrandGradient}" Margin="0,0,14,0">
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="21"
                               Foreground="{DynamicResource OnBrandBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHeaderTitle" Text="Install SpeedShare" Style="{StaticResource TitleText}"/>
                    <TextBlock x:Name="TxtHeaderSubtitle" Text="Private, direct, fast local file sharing" Style="{StaticResource BodyText}" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ===================== VIEW: INSTALL CONFIG ===================== -->
            <StackPanel Grid.Row="1" x:Name="InstallConfigPanel" VerticalAlignment="Center">
                <TextBlock Text="Destination folder" Style="{StaticResource BodyText}" FontSize="12" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtInstallPath" Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" Padding="11,9" FontSize="12" IsReadOnly="True"/>
                    <Button Grid.Column="1" Content="Browse…" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="16,8" Click="BtnBrowse_Click"/>
                </Grid>

                <StackPanel Margin="0,0,0,8">
                    <CheckBox x:Name="ChkDesktopShortcut" Content="Create desktop shortcut" IsChecked="True"
                              Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" FontSize="13"/>
                    <CheckBox x:Name="ChkStartMenuShortcut" Content="Create Start Menu shortcut" IsChecked="True"
                              Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" FontSize="13"/>
                    <CheckBox x:Name="ChkLaunchOnFinish" Content="Launch SpeedShare after installation" IsChecked="True"
                              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                </StackPanel>
            </StackPanel>

            <!-- ===================== VIEW: PROGRESS ===================== -->
            <StackPanel Grid.Row="1" x:Name="ProgressPanel" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="TxtProgressStatus" Text="Extracting application files…" Style="{StaticResource TitleText}" FontSize="15" Margin="0,0,0,12"/>
                <ProgressBar x:Name="SetupProgressBar" Height="8" Background="{DynamicResource RaisedBrush}"
                             Foreground="{DynamicResource BrandGradient}" BorderThickness="0" Margin="0,0,0,12" IsIndeterminate="True"/>
                <TextBlock x:Name="TxtProgressDetail" Text="Please wait while SpeedShare is being configured…" Style="{StaticResource BodyText}" FontSize="12"/>
            </StackPanel>

            <!-- ===================== VIEW: UNINSTALL ===================== -->
            <StackPanel Grid.Row="1" x:Name="UninstallPanel" VerticalAlignment="Center" Visibility="Collapsed">
                <Border Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="18"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Are you sure you want to uninstall SpeedShare?" Style="{StaticResource TitleText}" FontSize="15"/>
                        <TextBlock Text="This removes SpeedShare and its shortcuts from this computer." Style="{StaticResource BodyText}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===================== VIEW: COMPLETED ===================== -->
            <StackPanel Grid.Row="1" x:Name="FinishedPanel" VerticalAlignment="Center" Visibility="Collapsed">
                <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource SuccessSoftBrush}" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock Text="&#xE930;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{DynamicResource SuccessBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TxtFinishedTitle" Text="SpeedShare installed successfully!" Style="{StaticResource TitleText}" FontSize="17" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtFinishedSubtitle" Text="Open SpeedShare from your Desktop or Start Menu." Style="{StaticResource BodyText}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Bottom button bar -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" x:Name="BtnMainAction" Content="Install now" Style="{StaticResource ModernButton}"
                        Padding="28,11" FontSize="14" Click="BtnMainAction_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>

<Window x:Class="SpeedShareSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpeedShare Setup" 
        Height="420" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgDark}">

    <Grid Margin="24">
        <!-- Background Glow -->
        <Ellipse Width="300" Height="300" Fill="#0284C7" Opacity="0.08" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-60,-60,0,0" IsHitTestVisible="False"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="{StaticResource PrimaryGradient}" Margin="0,0,14,0">
                    <Path Stretch="Uniform" Width="22" Height="22" Fill="White" 
                          Data="M13,2.05V5.08C16.39,5.57 19,8.47 19,12C19,12.9 18.79,13.75 18.42,14.5L20.58,16.66C21.48,15.29 22,13.7 22,12C22,6.82 18.05,2.55 13,2.05M12,19A7,7 0 0,1 5,12C5,8.47 7.61,5.57 11,5.08V2.05C5.95,2.55 2,6.82 2,12A10,10 0 0,0 12,22C14.3,22 16.4,21.22 18.08,19.92L15.92,17.76C14.78,18.54 13.44,19 12,19M11,7V12.41L15.54,16.95L16.95,15.54L13,11.59V7H11Z"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHeaderTitle" Text="Install SpeedShare" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="18"/>
                    <TextBlock x:Name="TxtHeaderSubtitle" Text="Ultra-fast local file sharing for Windows &amp; Android" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ===================== VIEW: INSTALL CONFIG ===================== -->
            <StackPanel Grid.Row="1" x:Name="InstallConfigPanel" VerticalAlignment="Center">
                <TextBlock Text="Destination Folder:" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtInstallPath" Background="{StaticResource CardDark}" Foreground="White" 
                             BorderBrush="{StaticResource BorderDark}" Padding="10,8" FontSize="12" IsReadOnly="True"/>
                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="12,6" Click="BtnBrowse_Click"/>
                </Grid>

                <StackPanel Margin="0,0,0,10">
                    <CheckBox x:Name="ChkDesktopShortcut" Content="Create Desktop Shortcut" IsChecked="True" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkStartMenuShortcut" Content="Create Start Menu Shortcut" IsChecked="True" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkLaunchOnFinish" Content="Launch SpeedShare after installation" IsChecked="True" Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>
            </StackPanel>

            <!-- ===================== VIEW: PROGRESS / INSTALLING ===================== -->
            <StackPanel Grid.Row="1" x:Name="ProgressPanel" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="TxtProgressStatus" Text="Extracting application files..." Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                <ProgressBar x:Name="SetupProgressBar" Height="8" Background="{StaticResource CardDark}" Foreground="{StaticResource PrimaryGradient}" BorderThickness="0" Margin="0,0,0,10" IsIndeterminate="True"/>
                <TextBlock x:Name="TxtProgressDetail" Text="Please wait while SpeedShare is being configured..." Foreground="{StaticResource TextMuted}" FontSize="12"/>
            </StackPanel>

            <!-- ===================== VIEW: UNINSTALL CONFIRMATION ===================== -->
            <StackPanel Grid.Row="1" x:Name="UninstallPanel" VerticalAlignment="Center" Visibility="Collapsed">
                <Border Background="{StaticResource CardDark}" CornerRadius="10" Padding="16" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Are you sure you want to uninstall SpeedShare?" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="This will remove SpeedShare and all its shortcuts from your computer." Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===================== VIEW: COMPLETED ===================== -->
            <StackPanel Grid.Row="1" x:Name="FinishedPanel" VerticalAlignment="Center" Visibility="Collapsed">
                <Border Width="48" Height="48" CornerRadius="24" Background="#0C4A6E" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Path Stretch="Uniform" Width="22" Height="22" Fill="{StaticResource AccentGreen}" Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"/>
                </Border>
                <TextBlock x:Name="TxtFinishedTitle" Text="SpeedShare Installed Successfully!" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtFinishedSubtitle" Text="You can now open SpeedShare from your Desktop or Start Menu." Foreground="{StaticResource TextSecondary}" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Bottom Buttons Bar -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" x:Name="BtnMainAction" Content="Install Now" Style="{StaticResource ModernButton}" 
                        Padding="24,10" FontSize="13" FontWeight="Bold" Click="BtnMainAction_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ SpeedShare 2.0 "Prism" — Dark (installer) ============ -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#0B1220"/>
    <SolidColorBrush x:Key="CardBrush" Color="#131C2E"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#1B2740"/>
    <SolidColorBrush x:Key="RaisedBrush" Color="#1B2740"/>
    <SolidColorBrush x:Key="FieldBrush" Color="#0E1626"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#26344D"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#364763"/>

    <SolidColorBrush x:Key="BrandBrush" Color="#60A5FA"/>
    <SolidColorBrush x:Key="OnBrandBrush" Color="#0B1220"/>
    <SolidColorBrush x:Key="BrandSoftBrush" Color="#1E3A8A"/>
    <SolidColorBrush x:Key="OnBrandSoftBrush" Color="#DBEAFE"/>
    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#3B82F6" Offset="0"/>
        <GradientStop Color="#22D3EE" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#064E3B"/>
    <SolidColorBrush x:Key="OnSuccessSoftBrush" Color="#6EE7B7"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#F43F5E"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#22D3EE"/>
</ResourceDictionary>
